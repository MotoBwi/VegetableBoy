generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Zone {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  name            String              @unique
  area            String
  users           User[]
  zoneDeliveryPersons ZoneDeliveryPerson[]
  orders          Order[]
  paymentAttempts PaymentAttempt[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model DeliveryPerson {
  id           String                     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  phone        String                     @unique
  password     String                     @default("")
  image        String                     @default("")
  zoneDeliveryPersons ZoneDeliveryPerson[]
  settlements  DeliveryPersonSettlement[]
  orders       Order[]
  active       Boolean                    @default(true)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model ZoneDeliveryPerson {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  zoneId           String         @db.ObjectId
  zone             Zone           @relation(fields: [zoneId], references: [id])
  deliveryPersonId String         @db.ObjectId
  deliveryPerson   DeliveryPerson @relation(fields: [deliveryPersonId], references: [id])

  @@unique([zoneId, deliveryPersonId])
}

model DeliveryPersonSettlement {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  deliveryPersonId String         @db.ObjectId
  deliveryPerson   DeliveryPerson @relation(fields: [deliveryPersonId], references: [id])
  date             String         // YYYY-MM-DD
  cashAmount       Int            @default(0)
  onlineAmount     Int            @default(0)
  notes            String         @default("")
  createdAt        DateTime       @default(now())
}

model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  phone           String           @unique
  password        String           @default("")
  image           String           @default("")
  zoneId          String           @db.ObjectId
  zone            Zone             @relation(fields: [zoneId], references: [id])
  block           String
  building        String
  flat            String
  active          Boolean          @default(true)
  orders          Order[]
  paymentAttempts PaymentAttempt[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Product {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  name       String      @unique
  image      String      @default("")
  category   String
  available  Boolean     @default(true)
  price250   Int         @default(0)
  price500   Int         @default(0)
  price1kg   Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  userId           String      @db.ObjectId
  user             User        @relation(fields: [userId], references: [id])
  zoneId           String      @db.ObjectId
  zone             Zone        @relation(fields: [zoneId], references: [id])
  deliveryPersonId String?     @db.ObjectId
  deliveryPerson   DeliveryPerson? @relation(fields: [deliveryPersonId], references: [id])
  total            Int         // items subtotal
  deliveryCharge   Int         @default(15)
  status           OrderStatus @default(pending)
  payment          PaymentType?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  variant   String   // 250g | 500g | 1kg
  qty       Int
  createdAt DateTime @default(now())
}

enum OrderStatus {
  pending
  delivered
  failed
}

enum PaymentType {
  cash
  online
}

model PaymentAttempt {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id])
  zoneId            String   @db.ObjectId
  zone              Zone     @relation(fields: [zoneId], references: [id])
  total             Int
  deliveryCharge    Int      @default(15)
  itemsJson         String
  status            String   @default("created")
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  failureReason     String   @default("")
  orderId           String?  @db.ObjectId
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
